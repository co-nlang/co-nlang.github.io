import DimensionPage from '../components/DimensionPage.astro';
import { pageMeta } from '../i18n/ui';
const lang = 'zh-TW' as const;
const key = 'discovery';
---
<BaseLayout lang={lang} title={`${pageMeta[key][lang].title} — n/`}>
