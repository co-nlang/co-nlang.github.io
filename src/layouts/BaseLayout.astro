---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localize, type Lang } from '../i18n/ui';

interface Props { lang: Lang; title: string; description?: string }
const { lang, title, description = '' } = Astro.props;
const htmlLang = lang === 'zh-TW' ? 'zh-Hant' : 'en';
const path = Astro.url.pathname;
const unprefixed = path.replace(/^\/en(?=\/|$)/, '') || '/';
const canonical = new URL(path, Astro.site);
const zhHref = new URL(unprefixed, Astro.site);
const localizedEn = localize(unprefixed, 'en');
const enHref = new URL(localizedEn === '/en' ? '/en/' : localizedEn, Astro.site);
const routeKey = unprefixed.replace(/\/$/, '') || '/';
const placeholders = new Set(['/language', '/discovery', '/research', '/join', '/blog']);
const noindex = placeholders.has(routeKey);
const ogLocale = lang === 'zh-TW' ? 'zh_TW' : 'en_US';
const ogAlternateLocale = lang === 'zh-TW' ? 'en_US' : 'zh_TW';
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-Hant" href={zhHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={zhHref} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="n/" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogAlternateLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8C%80%3C/text%3E%3C/svg%3E" />
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem('theme');
          if (s === 'dark' || s === 'light') document.documentElement.setAttribute('data-theme', s);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Header lang={lang} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>
