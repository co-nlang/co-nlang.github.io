---
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
---
<footer>
  <div class="wrap">
    <div class="stamp" set:html={tr('footer.stamp')}></div>
    <div class="tag2">{tr('footer.tag')}</div>
  </div>
</footer>
