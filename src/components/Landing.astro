---
import type { Lang } from '../i18n/ui';
import { landing } from '../i18n/landing';
import composition from '../snippets/two-programs-compose.json';
import HeroCanvas from './HeroCanvas.astro';
import StoneTablet from './StoneTablet.astro';
import CodeBlock from './CodeBlock.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = landing[lang];

const found = import.meta.glob<{
  default: { engine: string; claims: number };
}>('../i18n/verified.json', { eager: true });
const receipt = Object.values(found)[0]?.default ?? null;
const receiptText = receipt
  ? c.evidence.receipt
      .replace('{engine}', receipt.engine)
      .replace('{claims}', String(receipt.claims))
  : c.evidence.noReceipt;
const command = `oo run ${composition.files.map((file) => file.name).join(' ')} --observe ${composition.observe}`;
---

<section class="hero">
  <HeroCanvas />
  <div class="wrap">
    <div class="hero-copy">
      <span class="eyebrow">{c.hero.eyebrow}</span>
      <div class="wordmark">n<span class="sl">/</span></div>
      <h1>{c.hero.headline}</h1>
      <p class="lead">{c.hero.lead}</p>
      <div class="cta-row">
        <a class="btn btn-gold" href="#compose">{c.hero.cta1}</a>
        <a class="btn btn-ghost" href="#thesis">{c.hero.cta2}</a>
      </div>
    </div>
  </div>
</section>

<div class="rule"></div>

<section id="compose" class="compose-sec">
  <div class="wrap">
    <span class="eyebrow">{c.compose.eyebrow}</span>
    <h2>{c.compose.title}</h2>
    <p class="lead section-lead">{c.compose.lead}</p>

    <div class="composition">
      <div class="source-pair">
        {composition.files.map((file, index) => (
          <>
            {index > 0 && <div class="meet-mark" aria-hidden="true">&amp;</div>}
            <CodeBlock code={file.source.trimEnd()} cap={`${c.compose.sourceLabel} · ${file.name}`} copy lang={lang} />
          </>
        ))}
      </div>
      <div class="converges" aria-hidden="true"><span></span><b>↓</b><span></span></div>
      <CodeBlock code={composition.expected} cap={c.compose.resultLabel} copy lang={lang} />
      <div class="runline">
        <span>{c.compose.commandLabel}</span>
        <code>{command}</code>
      </div>
    </div>

    <p class="lineage" set:html={c.compose.lineage}></p>
  </div>
</section>

<div class="rule"></div>

<section id="thesis" class="thesis-sec">
  <div class="wrap">
    <span class="eyebrow">{c.thesis.eyebrow}</span>
    <h2>{c.thesis.title}</h2>
    <p class="lead section-lead">{c.thesis.lead}</p>
    <div class="thesis-grid">
      {c.thesis.items.map((item) => (
        <article class="thesis-card">
          <div class="thesis-mark">{item.mark}</div>
          <h3>{item.verb}</h3>
          <p class="question">{item.question}</p>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<div class="rule"></div>

<section id="method" class="method-sec">
  <div class="wrap method-copy">
    <span class="eyebrow">{c.method.eyebrow}</span>
    <h2>{c.method.title}</h2>
    <p class="lead section-lead">{c.method.lead}</p>
    <div class="method-steps">
      {c.method.steps.map((step) => (
        <article class="method-step">
          <div class="step-n">{step.n}</div>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </article>
      ))}
    </div>
    <p class="tablet-intro">{c.method.tabletIntro}</p>
  </div>
  <StoneTablet lang={lang} />
</section>

<div class="rule"></div>

<section id="evidence" class="evidence-sec">
  <div class="wrap evidence-grid">
    <div class="evidence-copy">
      <span class="eyebrow">{c.evidence.eyebrow}</span>
      <h2>{c.evidence.title}</h2>
      <p class="lead">{c.evidence.lead}</p>
      <p class:list={["receipt-card", { verified: Boolean(receipt) }]} set:html={receiptText}></p>
    </div>
    <a class="story-card" href={c.evidence.storyHref}>
      <span class="eyebrow">{c.evidence.storyEyebrow}</span>
      <h3>{c.evidence.storyTitle}</h3>
      <p>{c.evidence.storyBody}</p>
      <span class="story-tag">{c.evidence.storyTag}</span>
    </a>
  </div>
</section>

<div class="rule"></div>

<section id="paths" class="paths-sec">
  <div class="wrap">
    <span class="eyebrow">{c.paths.eyebrow}</span>
    <h2>{c.paths.title}</h2>
    <p class="lead section-lead">{c.paths.lead}</p>
    <div class="path-grid">
      {c.paths.items.map((item) => (
        <a class="path-card" href={item.href}>
          <span class="path-mark">{item.mark}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <span class="path-tag">{item.tag}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<div class="rule"></div>

<section id="join" class="join">
  <div class="wrap join-grid">
    <div>
      <span class="eyebrow">{c.join.eyebrow}</span>
      <h2>{c.join.title}</h2>
      <p class="lead">{c.join.lead}</p>
      <p class="coda">{c.join.coda}</p>
    </div>
    <div class="repos">
      <a class="repo" href="https://github.com/co-nlang/nlang-spec"><span class="r">@co-nlang/</span>nlang-spec</a>
      <a class="repo" href="https://github.com/co-nlang/nlang-tools"><span class="r">@co-nlang/</span>nlang-tools</a>
      <a class="repo" href="https://github.com/co-nlang/research"><span class="r">@co-nlang/</span>research</a>
      <a class="repo" href="https://github.com/co-nlang"><span class="r">github.com/</span>co-nlang</a>
    </div>
  </div>
</section>
