---
import type { Lang } from '../i18n/ui';
import { localize } from '../i18n/ui';
import { landing } from '../i18n/landing';
import HeroCanvas from './HeroCanvas.astro';
import StoneTablet from './StoneTablet.astro';
import CodeBlock from './CodeBlock.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = landing[lang];

// line-art motifs for the four dimension cards, in card order
const motifs = [
  `<svg viewBox="0 0 80 80" fill="none" stroke="var(--gold)" stroke-width="1.4"><circle cx="40" cy="10" r="3.2"/><circle cx="18" cy="40" r="3.2"/><circle cx="62" cy="40" r="3.2"/><circle cx="40" cy="70" r="3.2"/><path d="M40 13 L20 38 M40 13 L60 38 M20 43 L38 67 M60 43 L42 67 M21 40 H59"/></svg>`,
  `<svg viewBox="0 0 80 80" fill="none" stroke="var(--indigo)" stroke-width="1.4"><path d="M4 40 Q19 12 34 40 T64 40"/><path d="M4 48 Q19 76 34 48 T64 48" opacity=".55"/><circle cx="64" cy="44" r="3" fill="var(--indigo)" stroke="none"/></svg>`,
  `<svg viewBox="0 0 80 80" fill="none" stroke="var(--gold)" stroke-width="1.4"><path d="M22 20 L10 40 L22 60 M58 20 L70 40 L58 60"/><path d="M34 52 L46 28" stroke-width="1.2"/></svg>`,
  `<svg viewBox="0 0 80 80" fill="none" stroke="var(--indigo)" stroke-width="1.3"><g transform="translate(40 40)"><path d="M0 -30 L28.5 9.3 L17.6 24.3 L-17.6 24.3 L-28.5 9.3 Z" opacity=".35"/><path d="M0 -30 L17.6 24.3 L-28.5 9.3 L28.5 9.3 L-17.6 24.3 Z"/></g></svg>`,
];
---
<section class="hero">
  <HeroCanvas />
  <div class="wrap">
    <div class="hero-copy">
      <span class="eyebrow">{c.hero.eyebrow}</span>
      <div class="wordmark">n<span class="sl">/</span></div>
      <h1>{c.hero.headline}</h1>
      <p class="lead">{c.hero.lead}</p>
      <div class="cta-row">
        <a class="btn btn-gold" href="#why">{c.hero.cta1}</a>
        <a class="btn btn-ghost" href={localize('/join', lang)}>{c.hero.cta2}</a>
      </div>
    </div>
  </div>
</section>

<div class="rule"></div>

<StoneTablet lang={lang} />

<div class="rule"></div>

<section id="why">
  <div class="wrap">
    <span class="eyebrow">{c.why.eyebrow}</span>
    <h2>{c.why.title}</h2>
    <p class="lead" style="max-width:60ch" set:html={c.why.lead}></p>
    <div class="trinity">
      {c.why.tri.map((tri) => (
        <div class="tri">
          <div class="role">{tri.role}</div>
          <h3>{tri.name}</h3>
          <CodeBlock code={tri.code} />
        </div>
      ))}
    </div>
    <div class="demo">
      <CodeBlock code={c.why.demoCode} cap={c.why.demoCap} copy lang={lang} />
      <div class="note" set:html={c.why.note}></div>
    </div>
  </div>
</section>

<div class="rule"></div>

<section id="dims">
  <div class="wrap">
    <span class="eyebrow">{c.dims.eyebrow}</span>
    <h2>{c.dims.title}</h2>
    <p class="lead" style="max-width:56ch">{c.dims.lead}</p>
    <div class="dims">
      {c.dims.items.map((d, i) => (
        <a class="dim" href={localize(d.href, lang)}>
          <span class="motif" set:html={motifs[i]} />
          <div class="idx">{d.idx}</div>
          <h3>{d.title}</h3>
          <p set:html={d.body}></p>
          {d.honest && <div class="honest" set:html={d.honest} />}
          <span class="tag">{d.tag}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<div class="rule"></div>

<section id="join" class="join">
  <div class="wrap">
    <span class="eyebrow">{c.join.eyebrow}</span>
    <h2>{c.join.title}</h2>
    <div class="co-eq" set:html={c.join.coEq}></div>
    <p class="lead" style="max-width:58ch;margin-bottom:8px">{c.join.lead}</p>
    <div class="council">
      {c.join.traits.map((tr) => (
        <div class="seat">
          <div class="n">{tr.n}</div>
          <h3>{tr.title}</h3>
          <p>{tr.body}</p>
        </div>
      ))}
    </div>
    <div class="join-code">
      <CodeBlock code={c.join.code} copy lang={lang} />
    </div>
    <p class="coda">{c.join.coda}</p>
    <div class="repos">
      <a class="repo" href="https://github.com/co-nlang/nlang-spec"><span class="r">@co-nlang/</span>nlang-spec</a>
      <a class="repo" href="https://github.com/co-nlang/nlang-tools"><span class="r">@co-nlang/</span>nlang-tools</a>
      <a class="repo" href="https://github.com/co-nlang/rfcs"><span class="r">@co-nlang/</span>rfcs</a>
      <a class="repo" href="https://github.com/co-nlang/research"><span class="r">@co-nlang/</span>research</a>
    </div>
  </div>
</section>
